{
  "name": "utilia-solana-agent",
  "version": "0.5.6",
  "mcpName": "ink.utilia/solana-preflight",
  "description": "Pay-per-call audio normalization, PDF-to-Markdown, and budget-capped Solana x402 tools for autonomous agents.",
  "type": "module",
  "types": "src/index.d.ts",
  "bin": {
    "utilia-solana-agent": "src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "skills",
    "scripts/prepare-bundled-mcp.js",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "bundledDependencies": [
    "@hono/node-server",
    "@modelcontextprotocol/sdk",
    "@x402/mcp"
  ],
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "format:check": "prettier --check .github scripts src test skills README.md SECURITY.md package.json glama.json eslint.config.js tsconfig.json",
    "lint": "eslint scripts src test",
    "typecheck": "tsc --project tsconfig.json",
    "prepack": "node scripts/prepare-bundled-mcp.js",
    "consumer:check": "node scripts/verify-packed-consumer.js",
    "docker:smoke": "node scripts/docker-mcp-smoke.js",
    "test": "node --test",
    "test:coverage": "c8 --all --include='src/*.js' --check-coverage --lines=100 --functions=100 --branches=100 --statements=100 node --experimental-test-module-mocks --test",
    "pack:check": "npm pack --dry-run --silent"
  },
  "keywords": [
    "solana",
    "x402",
    "mcp",
    "agent",
    "ai-agent",
    "transaction-simulation",
    "priority-fees",
    "token-analysis",
    "pdf-to-markdown",
    "pdf-converter",
    "pdf-extraction",
    "document-extraction",
    "audio-normalization",
    "ffmpeg",
    "podcast",
    "llm-tools"
  ],
  "author": "Mohamed Kechaou",
  "license": "MIT",
  "homepage": "https://utilia.ink",
  "bugs": {
    "url": "https://github.com/mohamedkuch/utilia-solana-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedkuch/utilia-solana-agent.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "2.0.11",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@solana/kit": "5.5.1",
    "@x402/mcp": "2.19.0",
    "@x402/svm": "2.19.0",
    "bs58": "6.0.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "c8": "12.0.0",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
