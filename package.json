{
  "name": "utilia-solana-agent",
  "version": "0.4.1",
  "description": "Pay-per-call audio normalization, PDF-to-Markdown, and budget-capped Solana x402 tools for autonomous agents.",
  "type": "module",
  "bin": {
    "utilia-solana-agent": "src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "check": "node --check src/*.js",
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "solana",
    "x402",
    "mcp",
    "agent",
    "ai-agent",
    "transaction-simulation",
    "priority-fees",
    "token-analysis",
    "pdf-to-markdown",
    "pdf-converter",
    "pdf-extraction",
    "document-extraction",
    "audio-normalization",
    "ffmpeg",
    "podcast",
    "llm-tools"
  ],
  "author": "Mohamed Kechaou",
  "license": "MIT",
  "homepage": "https://utilia.ink",
  "bugs": {
    "url": "https://github.com/mohamedkuch/utilia-solana-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedkuch/utilia-solana-agent.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@solana/kit": "5.5.1",
    "@x402/mcp": "2.19.0",
    "@x402/svm": "2.19.0",
    "bs58": "6.0.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
