{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "types": ["node"]
  },
  "include": ["src/**/*.js", "examples/compatibility/**/*.mjs"]
}
